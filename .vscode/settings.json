{
    // Disable formatting for Jinja2 templates to preserve {{ }} syntax
    "[html]": {
        "editor.formatOnSave": true
    },
    "files.associations": {
        "*.html": "jinja-html"
    },
    // Exclude templates from Prettier
    "prettier.ignorePath": ".prettierignore",
    // Python: Ruff is the single source of truth
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
        }
    },
    // Python 3.14 venv of the project; Ruff runs the version pinned there, not the bundled one
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "ruff.importStrategy": "fromEnvironment",
    // Pin the binary: the extension's bundled Ruff is older than required-version and falls back to default (4-space) formatting
    "ruff.path": ["${workspaceFolder}/.venv/bin/ruff"],
    // Prefer project pyproject.toml / ruff.toml over editor overrides
    "ruff.configurationPreference": "filesystemFirst"
}
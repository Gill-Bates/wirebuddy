{
    "extends": [
        "config:best-practices"
    ],
    "timezone": "Europe/Berlin",
    "schedule": [
        "before 6am on Monday"
    ],
    "labels": [
        "dependencies",
        "renovate"
    ],
    "rebaseWhen": "behind-base-branch",
    "commitMessagePrefix": "chore(deps):",
    "prConcurrentLimit": 3,
    "prHourlyLimit": 2,
    "docker": {
        "enabled": true
    },
    "packageRules": [
        {
            "description": "GitHub Actions: auto-merge minor/patch with digest pinning",
            "matchManagers": [
                "github-actions"
            ],
            "groupName": "github-actions",
            "automerge": true,
            "automergeType": "pr",
            "automergeStrategy": "squash",
            "matchUpdateTypes": [
                "minor",
                "patch"
            ],
            "minimumReleaseAge": "3 days",
            "pinDigests": true
        },
        {
            "description": "Docker images: pin digests for reproducibility",
            "matchManagers": [
                "dockerfile"
            ],
            "groupName": "docker-images",
            "automerge": false,
            "pinDigests": true,
            "labels": [
                "docker"
            ]
        },
        {
            "description": "Python dependencies: group and review",
            "matchManagers": [
                "pep621"
            ],
            "groupName": "python-dependencies",
            "automerge": false,
            "labels": [
                "python"
            ]
        },
        {
            "description": "Pinned workflow tool versions (actionlint, zizmor, Trivy CLI): reviewed, never auto-merged. ACTIONLINT_SHA256 and TRIVY_SHA256 in ci.yml are not bumped by Renovate, so such a PR fails closed at sha256sum --check until a human updates the checksum from the release's checksums file",
            "matchManagers": [
                "custom.regex"
            ],
            "automerge": false,
            "labels": [
                "ci-tooling"
            ]
        },
        {
            "description": "Trivy scanner (actions and pinned CLI version): reviewed bump, never auto-merged",
            "matchPackageNames": [
                "aquasecurity/trivy-action",
                "aquasecurity/trivy"
            ],
            "groupName": "trivy",
            "automerge": false,
            "minimumReleaseAge": "1 day",
            "schedule": [
                "at any time"
            ],
            "labels": [
                "security"
            ]
        },
        {
            "description": "Major version updates: require explicit review",
            "matchUpdateTypes": [
                "major"
            ],
            "automerge": false,
            "labels": [
                "breaking-change"
            ]
        }
    ],
    "vulnerabilityAlerts": {
        "enabled": true,
        "labels": [
            "security",
            "critical"
        ]
    },
    "customManagers": [
        {
            "description": "Tool versions in workflow env/with values, marked by a '# renovate:' comment on the line above",
            "customType": "regex",
            "managerFilePatterns": [
                "/^\\.github/workflows/[^/]+\\.ya?ml$/"
            ],
            "matchStrings": [
                "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+[A-Za-z_]+:\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
            ]
        }
    ]
}

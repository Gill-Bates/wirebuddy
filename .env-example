# WireBuddy Configuration
# Copy this file to .env (or settings.env) and adjust values.
# Most settings auto-detect from WIREBUDDY_PUBLIC_ORIGIN; only add the
# others if you have a reason to override the default behavior.

# -----------------------------------------------------------------------------
# Core App
# -----------------------------------------------------------------------------

# Required in master mode.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WIREBUDDY_SECRET_KEY=

# master | node
SERVER_MODE=master

# CRITICAL | ERROR | WARNING | INFO | DEBUG
LOG_LEVEL=INFO

# Application timezone for UI/scheduler formatting, e.g. Europe/Berlin
TZ=UTC

# Overrideable data directory. Default: data/ locally, /app/data in Docker.
# WIREBUDDY_DATA_DIR=

# Development only: enable uvicorn reload
# WIREBUDDY_DEV_RELOAD=false


# -----------------------------------------------------------------------------
# Reverse Proxy / Public Origin
# -----------------------------------------------------------------------------

# Canonical public URL of this instance. Configuring this alone derives:
#   - CSRF allowed origins
#   - Passkey/WebAuthn relying-party ID and expected origin
#   - The Host-header allowlist (TrustedHostMiddleware)
#   - Secure cookie flags and HSTS (enabled automatically for https://)
# WIREBUDDY_PUBLIC_ORIGIN=https://vpn.example.com

# CIDRs of your reverse proxy, comma-separated. Controls which peers'
# X-Forwarded-* headers (client IP, HTTPS detection) and mTLS client-cert
# fingerprint headers are trusted, and is passed to uvicorn as
# --forwarded-allow-ips. Default: loopback only (127.0.0.0/8,::1/128) for
# cookie/HTTPS detection; the public /status page and node mTLS checks trust
# nothing until this is set explicitly.
# WIREBUDDY_TRUSTED_PROXIES=127.0.0.0/8,::1/128

# Additional CSRF-trusted origins beyond WIREBUDDY_PUBLIC_ORIGIN, e.g. when
# serving under multiple hostnames.
# WIREBUDDY_CSRF_ALLOWED_ORIGINS=


# -----------------------------------------------------------------------------
# Passkeys / WebAuthn
# -----------------------------------------------------------------------------

# Override the relying-party ID if auto-detection from WIREBUDDY_PUBLIC_ORIGIN
# is not desired.
# PASSKEY_RP_ID=


# -----------------------------------------------------------------------------
# Node Mode Only
# -----------------------------------------------------------------------------

# Initial bootstrap token and its HMAC verification key. Both are required for
# first enrollment unless an explicit insecure development override is used.
# WIREBUDDY_ENROLLMENT_TOKEN=
# WIREBUDDY_ENROLLMENT_VERIFY_KEY=

# Optional custom CA bundle for master API TLS validation.
# WIREBUDDY_MASTER_CA_FILE=/app/data/certs/master-ca.pem

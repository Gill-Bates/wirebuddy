# WireBuddy Configuration
# Copy this file to .env (or settings.env) and adjust values.
# Most settings auto-detect from WIREBUDDY_PUBLIC_ORIGIN; only add the
# others if you have a reason to override the default behavior.

# -----------------------------------------------------------------------------
# Core App
# -----------------------------------------------------------------------------

# Required in master mode.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WIREBUDDY_SECRET_KEY=

# master | node
SERVER_MODE=master

# CRITICAL | ERROR | WARNING | INFO | DEBUG
LOG_LEVEL=INFO

# Overrideable data directory. Default: data/ locally, /app/data in Docker.
# WIREBUDDY_DATA_DIR=

# Development only: enable uvicorn reload
# WIREBUDDY_DEV_RELOAD=false


# -----------------------------------------------------------------------------
# Reverse Proxy / Public Origin
# -----------------------------------------------------------------------------

# Canonical public URL of this instance. Configuring this alone derives:
#   - CSRF allowed origins
#   - Passkey/WebAuthn relying-party ID and expected origin
#   - The Host-header allowlist (TrustedHostMiddleware)
#   - Secure cookie flags (enabled automatically for https://)
# HSTS does not depend on it: it is sent on HTTPS requests (directly or via a
# trusted proxy) or always with WIREBUDDY_FORCE_HSTS=true.
# WIREBUDDY_PUBLIC_ORIGIN=https://vpn.example.com

# CIDRs of your reverse proxy, comma-separated. Controls which peers'
# X-Forwarded-* headers (client IP, HTTPS detection) are trusted, and is passed
# to uvicorn as --forwarded-allow-ips. Default: loopback only
# (127.0.0.0/8,::1/128) for cookie/HTTPS detection; the public /status page
# trusts nothing beyond loopback until this is set explicitly. It does NOT
# make a proxy trusted for the mTLS fingerprint header (see below).
# WIREBUDDY_TRUSTED_PROXIES=127.0.0.0/8,::1/128
# CIDRs of the controlled reverse proxies allowed to deliver the node mTLS
# client-cert fingerprint header (X-Client-Cert-Fingerprint). Separate from
# WIREBUDDY_TRUSTED_PROXIES. Default: empty, no proxy is trusted and the header
# is ignored. Every proxy in front must strip a client-supplied header of that
# name; only the mTLS-terminating proxy may set it. Invalid entries are ignored.
# List only the specific proxy IPs: any host in a broad range could forge a
# fingerprint. Read once at startup; changing it needs a restart.
# WIREBUDDY_MTLS_PROXIES=

# Additional CSRF-trusted origins beyond WIREBUDDY_PUBLIC_ORIGIN, e.g. when
# serving under multiple hostnames.
# WIREBUDDY_CSRF_ALLOWED_ORIGINS=

# Node enrollment tokens (master). Version 2 tokens are signed with an Ed25519
# key that stays on the master; nodes only hold the public key.
# Version of newly issued tokens: 2 (default) or 1 (legacy HMAC, only for node
# images that predate v2).
# WIREBUDDY_ENROLLMENT_TOKEN_VERSION=2
# Accept legacy v1 tokens at /api/nodes/enroll. Default 1 during 2.0.x; set 0
# once every node is enrolled or re-enrolled with a v2 token.
# WIREBUDDY_ENROLLMENT_ACCEPT_V1=1


# -----------------------------------------------------------------------------
# Passkeys / WebAuthn
# -----------------------------------------------------------------------------

# Override the relying-party ID if auto-detection from WIREBUDDY_PUBLIC_ORIGIN
# is not desired.
# PASSKEY_RP_ID=


# -----------------------------------------------------------------------------
# Node Mode Only
# -----------------------------------------------------------------------------

# Initial bootstrap token and the master's PUBLIC verification key ("wbpk2:...",
# returned with the token on create/regenerate and by GET /api/nodes/enrollment-key;
# never take it from the token itself). Both are required for first enrollment unless an explicit
# insecure development override is used. After enrollment the key is no longer
# needed. A value that does not start with "wbpk2:" is the deprecated legacy
# master secret for v1 tokens: it lets this host forge tokens, so replace it.
# WIREBUDDY_ENROLLMENT_TOKEN=
# WIREBUDDY_ENROLLMENT_VERIFY_KEY=

# Migration flags for legacy (v1, HMAC) enrollment tokens. Default 1 during 2.0.x.
# Node: accept a v1 token verified with the legacy secret. A node that pins a
# "wbpk2:" key always refuses v1 tokens.
# WIREBUDDY_ENROLLMENT_ALLOW_V1=1

# Optional custom CA bundle for master API TLS validation.
# WIREBUDDY_MASTER_CA_FILE=/app/data/certs/master-ca.pem
